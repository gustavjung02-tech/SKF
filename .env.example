ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional when ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

NEXT_PUBLIC_SHOW_ASSISTANT_PROVIDER=false

# Form email delivery (required for /api/forms/contact and /api/forms/lead)
RESEND_API_KEY=

# Internal inbox receiving all form submissions
FORM_MAIL_TO=gustavjung02@gmail.com

# Default sender for all website emails
FORM_MAIL_FROM=

# Optional sender overrides by context
FORM_MAIL_FROM_SUPPORT=
FORM_MAIL_FROM_SALES=
FORM_MAIL_FROM_RECRUITMENT=
FORM_MAIL_FROM_SECURITY=

# Optional base URL for images in form emails
# Example: https://skf-congnghiep.info
FORM_ASSET_BASE_URL=

# Optional external Studio URL for Cloudflare production
# Example: https://studio.your-domain.com or https://your-project.sanity.studio
STUDIO_EXTERNAL_URL=

# Admin RFQ / Google Sheet webhook
ADMIN_LOGIN_EMAIL=gustavjung02@gmail.com
ADMIN_SECRET=
ADMIN_COOKIE_NAME=khuongbinh
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=
